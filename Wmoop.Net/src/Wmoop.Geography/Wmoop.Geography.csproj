<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wmoop.Geography — an L1 domain module demonstrating the COMPOSITE pattern.
    Administrative containment (country ⊃ county ⊃ city) is part_of composition,
    NOT inheritance. Depends only on the kernel (invariant #5: acyclic graph).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Wmoop.Geography</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wmoop.Core\Wmoop.Core.csproj" />
  </ItemGroup>

</Project>
