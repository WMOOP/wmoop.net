<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runnable showcase of the design patterns over the WMOOP model. No external packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wmoop.Patterns.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wmoop.Core\Wmoop.Core.csproj" />
    <ProjectReference Include="..\Wmoop.Nature\Wmoop.Nature.csproj" />
    <ProjectReference Include="..\Wmoop.Transport\Wmoop.Transport.csproj" />
    <ProjectReference Include="..\Wmoop.Geography\Wmoop.Geography.csproj" />
    <ProjectReference Include="..\Wmoop.Patterns\Wmoop.Patterns.csproj" />
  </ItemGroup>

</Project>
