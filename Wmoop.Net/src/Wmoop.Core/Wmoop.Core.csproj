<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wmoop.Core — the C# projection of the WMOOP meta-model (L0 / upper ontology).
    It carries no domain knowledge; it only provides the foundational categories
    (Entity, Role, Quantity, ConceptId) that every domain module builds on.
    Pure BCL: no external NuGet packages, so it restores and builds offline.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are intentionally the norm here; do not warn on the few helpers left undocumented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Wmoop.Core</RootNamespace>
  </PropertyGroup>

</Project>
