<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the shared conformance vectors of wmoop.doc (external/wmoop.doc/conformance/suite.json)
    against the generated classes. A plain console app whose exit code is non-zero on failure (so
    CI can gate on it), with no test framework and no package, so the whole solution builds and
    tests fully offline (invariant #6: machine-checkable Definition of Done).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wmoop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every generated project, so a vector about any domain finds its types by WmId. -->
    <ProjectReference Include="..\..\..\generated\*\*.csproj" />
  </ItemGroup>

</Project>
